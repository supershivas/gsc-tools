{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/sync-design-system.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/vendor/**)",
      "Read(./dist/**)"
    ]
  }
}
